# Activates the project venv on `cd` — direnv loads this file on every prompt.
# scripts/install.sh installs direnv, adds its shell hook and allows this file, so a clone
# behaves the same as the machine it was set up on.
#
# The venv is created once by scripts/install.sh. This recreates it if it is missing, so a
# fresh clone still opens with the right interpreter instead of the system's `python3`
# (Homebrew's is 3.13+, and pyproject.toml requires >=3.10,<3.13 because spacy has no wheels
# for 3.13+).
if ! test -d .venv; then
  if command -v python3.12 >/dev/null 2>&1; then
    python3.12 -m venv .venv
  else
    echo "epubcast: .venv is missing and python3.12 is not on PATH — run ./scripts/install.sh" >&2
    return 0
  fi
fi
source .venv/bin/activate
